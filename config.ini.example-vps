[server]
; Для работы сервера с ipv4 и ipv6
ip = 0.0.0.0, ::
; Включить/Отключить логирование, нужно для тестирования, если есть проблемы
verbose = true

[keys]
; Формат: имя = порт:секрет[:домен]
; Если указан домен — ключ становится Fake TLS (ee-режим)
; В ссылке для ee-ключей автоматически добавляется префикс "ee"
1 = 77777:12345678123456781234567812345678:cdnjs.cloudflare.com
2 = 4321:12345678123456781234567812345678


; !ВНИМАНИЕ! СМОТРИ КЛЮЧИ НЕ В ЭТОМ ФАЙЛЕ, А ЧЕРЕЗ КОМАНДУ:
; python3 tg-proxy.py -l

[datacenters]
1 = 149.154.175.50
2 = 149.154.167.51
3 = 149.154.175.100
4 = 149.154.167.91
5 = 149.154.171.5
203 = 91.105.192.100
