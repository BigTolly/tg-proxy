[server]
; Для работы сервера с ipv4 и ipv6
ip = 0.0.0.0, ::
verbose = false

[keys]
; Формат: имя = порт:секрет[:домен]
; Если указан домен — ключ становится Fake TLS (ee-режим)
; В ссылке для ee-ключей автоматически добавляется префикс "ee"
1 = 7654:12345678123456781234567812345678
2 = 4567:12345678123456781234567812345678

; !ВНИМАНИЕ! СМОТРИ КЛЮЧИ НЕ В ЭТОМ ФАЙЛЕ, А ЧЕРЕЗ КОМАНДУ:
; python3 tg-proxy.py -l


[datacenters]
1 = 149.154.167.220
2 = 149.154.167.220
3 = 149.154.167.220
4 = 149.154.167.220
5 = 149.154.167.220
203 = 149.154.167.220


[upstream]
;можно подключиться по ipv4 или ipv6
;host = 99.88.77.66
host = aaaa:bbbb:cccc:dddd:eeee:ffff:aaaa
port = 77777
secret = 12345678123456781234567812345678
; Fake-TLS нужен для маскировки от DPI (Deep Packet Inspection) провайдера.
; Укажите домен одного из ваших сайтов размещенных на этом сервере, 
; либо домен из этой же страны, но не указываей домены из белых списков,
; иначе ТСПУ РКН заблокирует ваш IP, т.к. это подозрительно.
; Или в качестве домена можно указать CDN от популярного провайдера.
domain = cdnjs.cloudflare.com
dcs = 1,3,5,203
media = true
fallback = true
